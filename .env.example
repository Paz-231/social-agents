# Values belong in Replit deployment Secrets, never in Git.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
SOCIAL_OS_ADMIN_TOKEN=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
SOCIAL_OS_WORKSPACE=pasara-surf
PORT=3000
SOCIAL_OS_TICK_MS=30000
SOCIAL_OS_ENABLE_PUBLISHING=false
# No Postiz, CreatorOS, AI or ClickUp credentials are needed for this review service.
