# Place real values only in Replit development/deployment Secrets.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
SOCIAL_OS_BRANDS=[{"slug":"pasara-surf","name":"PASARA SURF","integrationId":"REPLACE_PASARA_ID","provider":"instagram"},{"slug":"runmycamp","name":"RunMyCamp","integrationId":"REPLACE_RUNMYCAMP_ID","provider":"instagram-standalone"}]
SOCIAL_OS_PRINCIPALS=[{"id":"owner","token":"REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS","workspaces":["pasara-surf","runmycamp"]}]
POSTIZ_API_KEY=REPLACE_WITH_POSTIZ_SECRET
POSTIZ_API_URL=https://api.postiz.com/public/v1
PORT=3000
SOCIAL_OS_TICK_MS=30000
SOCIAL_OS_ENABLE_PUBLISHING=false
# No ClickUp or CreatorOS credentials are used by this service.
# Legacy pilot importer uses a separate schema and is not part of the multi-brand UI.
